{
  "name": "local-orbit",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first AI memory layer, MCP server, and real-time control plane.",
  "license": "MIT",
  "author": "Akshat Gurnani",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Akshat-Gurnani/local-orbit.git"
  },
  "homepage": "https://github.com/Akshat-Gurnani/local-orbit#readme",
  "bugs": {
    "url": "https://github.com/Akshat-Gurnani/local-orbit/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ai-agents",
    "memory",
    "claude",
    "gemini",
    "codex",
    "cursor",
    "sqlite",
    "local-first"
  ],
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "bin": {
    "orbit-cli": "dist/cli.js"
  },
  "scripts": {
    "orbit": "tsx src/cli.ts",
    "mcp:http": "tsx src/mcp/server.ts --http",
    "mcp:stdio": "tsx src/mcp/server.ts --stdio",
    "web": "next dev -H 127.0.0.1 -p 3100",
    "web:start": "next start -H 127.0.0.1 -p 3100",
    "dev": "concurrently -n mcp,web -c cyan,magenta \"npm:mcp:http\" \"npm:web\"",
    "start": "concurrently -n mcp,web -c cyan,magenta \"npm:mcp:http\" \"npm:web:start\"",
    "build:server": "tsup",
    "build:web": "next build",
    "build": "npm run build:server && npm run build:web",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "setup": "npm run build && npm run orbit -- init"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "better-sqlite3": "^13.0.3",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "lucide-react": "^1.66.0",
    "next": "^16.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "uuid": "^14.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "concurrently": "^10.0.6",
    "tailwindcss": "^4.3.3",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
